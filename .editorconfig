# EditorConfig: https://EditorConfig.org
# Helps maintain consistent coding styles across editors and IDEs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.{html,css,scss,js,jsx,ts,tsx,vue}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.{sln,vcxproj,csproj}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.py]
max_line_length = 120
indent_size = 4

[*.{sql,csv}]
trim_trailing_whitespace = false
insert_final_newline = false
