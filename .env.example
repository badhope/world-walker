# 国家经济数据分析平台 - 配置文件模板
# 复制此文件为 .env 并填入实际值

# 基础配置
PROJECT_NAME=国家经济数据分析平台
VERSION=4.0.0
API_V1_STR=/api/v1

# 数据库配置
DATABASE_URL=sqlite:///./data/national_stats.db

# CORS 配置
CORS_ORIGINS=["*"]

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 爬虫配置
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY=1.0

# 缓存配置
CACHE_TTL=3600
CACHE_DIR=./data/cache

# 数据目录
DATA_DIR=./data
EXPORT_DIR=./data/exports
