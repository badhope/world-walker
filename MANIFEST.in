# sdist 打包清单：玩家壳资源、设定包与文档
# （wheel 侧由 pyproject 的 tool.setuptools.package-data 负责）

include LICENSE
include README.md
include README.zh-CN.md
include BRAND.md
include ARCHITECTURE.md
include ROADMAP.md
include CHANGELOG.md
include pyproject.toml

recursive-include settings *.json *.md
recursive-include narrative_skills *.md
recursive-include library *.json *.md
recursive-include scripts *.py
recursive-include docs *.png *.md *.mp4 *.json *.jsonl

include panel.html
include panel.css
include panel.js

prune __pycache__
prune .aqg
global-exclude *.py[cod]
