# Regional Industrial Economic Analysis Platform — Environment Configuration Template
# Copy this file to `.env` and modify values for your environment.
# In Docker Compose, environment variables in docker-compose.yml take precedence.
#
# Any value left empty or matching the obvious "change-me" sentinel will be
# rejected at startup when APP_ENV=production (see config/settings.py).

# === API Server ===
# Bind to 127.0.0.1 by default. Set to 0.0.0.0 only when running inside a
# trusted container/VM that fronts the service with a reverse proxy.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
WORKERS=1

# === Security ===
# Generate via: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Empty value is rejected in production.
SECRET_KEY=
JWT_ALGORITHM=HS256

# Admin credentials used by /api/v1/auth/login. Empty password → 503.
# Generate a strong password before exposing the service.
ADMIN_USER=admin
ADMIN_PASSWORD=

# HMAC key for model signing (load_with_signature / save_with_signature).
# Empty value forces unsigned-model rejection unless ALLOW_UNSIGNED_MODELS=1.
MODEL_SIGNING_KEY=

# === CORS ===
# Allowed origins for browser-based clients. Add the URL where the
# frontend (index.html) is served. Never include 0.0.0.0.
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080","http://127.0.0.1:8000","http://127.0.0.1:8080"]

# === Rate limiting ===
# Per-IP requests/minute across all endpoints. 0 disables.
RATE_LIMIT_PER_MIN=120

# === Trusted hosts ===
# Comma-separated. Defaults to localhost/testserver if empty.
TRUSTED_HOSTS=

# === Storage ===
DATA_DIR=data
CACHE_DIR=data/cache
LOG_DIR=data/logs
DATABASE_URL=sqlite:///data/regional_economic.db

# === Project Metadata ===
PROJECT_NAME=Regional Industrial Economic Analysis Platform
VERSION=4.0.0
LICENSE=GPL-3.0-or-later
REPO_URL=https://github.com/your-org/regional-economic-analysis
