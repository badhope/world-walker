  "lore": [
    {
      "keys": [
        "基调",
        "文风"
      ],
      "constant": true,
      "comment": "基调",
      "content": "凡人流修仙：先活，再修。每个境界都要拿资源、心境或记忆去换；不送系统，不送老爷爷，不保证好人有好报。NPC有自己的算盘。"
    },
    {
      "keys": [
        "九荒",
        "苍梧",
        "天裂"
      ],
      "constant": false,
      "comment": "九荒表层",
      "content": "九荒是九块大陆，苍梧在东荒边缘。二十年前天裂，山里多出裂口，井水变苦，草木疯长。宗门说这是灵潮退去；凡人只看见失踪的人越来越多。"
    },
    {
      "keys": [
        "裂谷",
        "骨文",
        "拾骨人"
      ],
      "constant": false,
      "comment": "裂谷",
      "content": "裂谷在镇西三十里，是已知唯一通向古墓的入口。拾骨人签生死契下墓，带上来带文的古骨，换灵砂。谷底夜里透白光，光会动。"
    },
    {
      "keys": [
        "青岚宗",
        "测骨",
        "收徒"
      ],
      "constant": false,
      "comment": "青岚宗",
      "content": "青岚宗在山门摆测骨台，测的是骨文共鸣。手放上去，台面亮；亮得越久，执事越客气。镇上人说，亮过三息的人都没再回来。"
    },
    {
      "keys": [
        "炼气",
        "筑基",
        "金丹",
        "境界"
      ],
      "constant": false,
      "comment": "修行阶梯",
      "content": "修行十阶：凡人→炼气→筑基→金丹→元婴→化神→炼虚→合体→大乘→渡劫。炼气引气入经脉，筑基立道基，金丹结骨文丹；越往上，越不像人。"
    },
    {
      "keys": [
        "黑水坊",
        "万骨堂",
        "灵砂"
      ],
      "constant": false,
      "comment": "黑水坊",
      "content": "黑水坊在苍梧镇下面的废渠里，柜台是棺材板拼的。灵砂十二枚碎银一撮；骨粉六枚；旧符八枚。周掌柜收古骨，不问来路。"
    },
    {
      "keys": [
        "陈砚",
        "大学生",
        "许青"
      ],
      "constant": false,
      "comment": "玩家与许青",
      "content": "陈砚是普通二本地质工程大三学生，实习时坠入裂谷；许青是同组同学，三天前在裂谷附近失联。陈砚没有灵根，背包里有一块黑色骨片。"
    },
    {
      "keys": [
        "骨片",
        "黑骨"
      ],
      "constant": false,
      "comment": "骨片",
      "content": "黑色骨片只有半个手掌大，表面没有纹，摸上去是温的。靠近古骨时，它会轻轻震一下；震过之后，陈砚会多出一段不属于自己的梦。"
    }
  ],
