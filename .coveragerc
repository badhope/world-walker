# pytest-cov configuration
# https://pytest-cov.readthedocs.io/

[run]
source = ["backend"]
branch = true
data_file = .coverage
parallel = true
concurrency = thread
omit =
    */tests/*
    */__init__.py
    */migrations/*
    */conftest.py
    */setup.py
    */main.py.bak

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    def __repr__
    if self\.debug
    if settings\.DEBUG
    if TYPE_CHECKING
    @(?:pytest_)?fixture\(
    ^\s*pass\s*$
    raise ImportError

# Ignore source code which can't be found
ignore_errors = true

# Skip files with no code
skip_empty = true

# Show line numbers of statements not executed
show_missing = true

# Report exclusions
exclude_also =
    \.\.\.
    \.currentmodule

# Sort coverage report by file path
sort = Cover

# Fail if coverage drops below threshold
# Set in CI via --cov-fail-under
# fail_under = 80

[html]
directory = htmlcov
title = Regional Economic Analysis — Coverage Report
extra_css = docs/coverage.css
show_contexts = true

[xml]
output = coverage.xml
package_depth = 2
