# 区域产业经济分析平台 - 环境配置示例
# 复制此文件为 .env 并修改相应配置

# ============================================
# 基础配置
# ============================================

# 项目名称
PROJECT_NAME=区域产业经济分析平台

# API服务配置
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=True

# 日志配置
LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log  # 可选，不设置则只输出到控制台

# 数据目录配置
DATA_DIR=./data
EXPORT_DIR=./data/exports

# 安全配置（生产环境请务必修改）
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# 分析参数配置
# ============================================

# 默认分析年份
DEFAULT_YEAR=2025

# 默认分析地区（可选值：深圳，或添加新的地区配置）
DEFAULT_REGION=深圳

# 默认分析产业（可选值：半导体，或添加新的产业配置）
DEFAULT_INDUSTRY=半导体

# 数据采集指标列表
# 可选指标：gdp, cpi, pmi, fiscal_revenue, industrial_output, employment
# DEFAULT_INDICATORS=gdp,cpi,pmi,fiscal_revenue,industrial_output

# 分析年份范围
# YEARS_RANGE=2020,2021,2022,2023,2024,2025

# ============================================
# 数据库配置（可选）
# ============================================

# SQLite 数据库路径
DATABASE_URL=sqlite:///./data/national_stats.db

# ============================================
# 爬虫配置（可选）
# ============================================

# 爬虫超时时间（秒）
SCRAPER_TIMEOUT=30

# 最大重试次数
SCRAPER_MAX_RETRIES=3

# 爬取间隔（秒）
SCRAPER_DELAY=1.0

# ============================================
# 缓存配置（可选）
# ============================================

# 缓存过期时间（秒）
CACHE_TTL=3600

# 缓存目录
CACHE_DIR=./data/cache

