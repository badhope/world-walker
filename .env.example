# National Stats — Environment Configuration Template
# Copy this file to `.env` and modify values for your environment.
# In docker-compose, environment variables in docker-compose.yml take precedence.

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# === Security ===
# IMPORTANT: change these to strong random strings in production
SECRET_KEY=change-this-to-a-random-secret-string
JWT_ALGORITHM=HS256
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
MODEL_SIGNING_KEY=change-this-signing-key

# === CORS ===
# Allowed origins for browser-based clients.
# Add the URL where the frontend (index.html) is served.
# Default: local dev (8000/8080) and 5173 (vite legacy)
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080","http://localhost:5173","http://127.0.0.1:8000","http://127.0.0.1:8080"]

# === Storage ===
DATA_DIR=data
CACHE_DIR=data/cache
LOG_DIR=data/logs
DATABASE_URL=sqlite:///data/national_stats.db
